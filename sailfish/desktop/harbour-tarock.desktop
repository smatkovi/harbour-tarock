[Desktop Entry]
Name=Tarock
Comment=Königrufen and Hungarian Tarokk with a learning mode
Icon=harbour-tarock
Exec=harbour-tarock
Type=Application
Categories=Game;
X-Sailfish-ApplicationType=Silica

[X-Sailjail]
Permissions=Internet;Bluetooth
OrganizationName=harbour-tarock
ApplicationName=harbour-tarock
# Der Tisch geht auch über Bluetooth, und dafür braucht es AF_BLUETOOTH-
# Sockets. Sailjails Seccomp-Filter lässt nur die Protokolle zu, die seine
# Berechtigungen nennen (Base "unix", Internet "inet,inet6,netlink");
# bluetooth nennt keine, im Käfig scheitert also jeder RFCOMM-Socket mit
# "Operation not supported". Die Kennung oben bleibt, an ihr hängt der Pfad
# der Einstellungen.
Sandboxing=Disabled
